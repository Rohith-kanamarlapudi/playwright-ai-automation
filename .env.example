# ======================================================
# DeepSeek Configuration
# ======================================================

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ======================================================
# Target Application
# ======================================================

TARGET_URL=https://live.ideabytesiot.com/demolive
LIVE_APP_URL=https://live.ideabytesiot.com/demolive
BASE_URL=https://live.ideabytesiot.com/demolive

# ======================================================
# Crawling Configuration
# ======================================================

MAX_PAGES=10

# Maximum selectors of each type passed to the LLM
SELECTOR_CAP=25

# SPA wait timeout (milliseconds)
SPA_WAIT_TIMEOUT=15000

# Maximum number of generated test cases
MAX_TESTS=30

# Maximum generation time (seconds)
GENERATION_TIMEOUT_SECONDS=240

# ======================================================
# Authentication
# ======================================================

EMAIL=your_email_here
PASSWORD=your_password_here

# ======================================================
# Optional API Authentication
# ======================================================

APP_API_KEY=your-secret-key-here